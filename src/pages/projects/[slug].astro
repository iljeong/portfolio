---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Flow from '../../components/Flow.astro';
import Architecture from '../../components/Architecture.astro';
import { projects } from '../../data/projects';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
const assetPath = (src: string) => `${basePath}${src.replace(/^\/+/, '')}`;
const idx  = projects.findIndex(p => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
const siteUrl = 'https://iljeong.github.io/portfolio';
const pageOgUrl = `${siteUrl}/projects/${project.slug}/`;
const problemShort = project.content.problem.split('. ')[0] + '.';
const hasInsights = (project.content.insights ?? []).length > 0;
const shots = project.screenshots ?? [];

type EvidenceMetric = {
  readonly value: string;
  readonly label: string;
  readonly note?: string;
  readonly countTo?: number;
  readonly precision?: number;
  readonly prefix?: string;
  readonly suffix?: string;
};
type EvidenceBar = {
  readonly label: string;
  readonly value: number;
  readonly display: string;
  readonly note?: string;
};
type EvidencePanel = {
  readonly title: string;
  readonly caption: string;
  readonly metrics: readonly EvidenceMetric[];
  readonly bars?: readonly EvidenceBar[];
  readonly stages?: readonly string[];
};

const evidenceBySlug: Record<string, EvidencePanel> = {
  fastcampus: {
    title: '출시까지 연결한 기획 범위',
    caption: '공개 가능한 성과는 출시 산출물과 제작 프로세스 중심으로 정리했습니다.',
    metrics: [
      { value: '6개', label: '신규 교육 상품', countTo: 6, suffix: '개' },
      { value: '4개', label: '직접 기획', countTo: 4, suffix: '개' },
      { value: '2개', label: 'PM 진행', countTo: 2, suffix: '개' },
    ],
    bars: [
      { label: '직접 기획', value: 67, display: '4/6' },
      { label: 'PM 진행', value: 33, display: '2/6' },
    ],
  },
  'gcar-voc': {
    title: '리뷰에서 검증한 이탈 신호',
    caption: '공개 리뷰 기반 지표라 내부 전환 지표는 제외하고, 비교 가능한 분석 근거만 노출했습니다.',
    metrics: [
      { value: '37,923건', label: '수집·분류 리뷰', countTo: 37923, suffix: '건' },
      { value: '0.976', label: '감정 분류 정확도', countTo: 0.976, precision: 3 },
      { value: '31.4%', label: 'Gcar 1점 리뷰 비율', countTo: 31.4, precision: 1, suffix: '%' },
    ],
    bars: [
      { label: 'Gcar 1점 리뷰', value: 31.4, display: '31.4%' },
      { label: 'Socar 1점 리뷰', value: 23.9, display: '23.9%' },
    ],
  },
  pullsize: {
    title: '추천 판단까지 이어지는 MVP 흐름',
    caption: '기능 수보다 사용자가 사이즈 선택 근거를 이해하는 순서를 우선했습니다.',
    metrics: [
      { value: '4단계', label: '추천 플로우', countTo: 4, suffix: '단계' },
      { value: '2인', label: '공동 구현 팀', countTo: 2, suffix: '인' },
      { value: 'GA', label: '추천·CTA 이벤트 계측' },
    ],
    stages: ['정보 입력', '데이터 추출', 'AI 추천', '근거 제시'],
  },
  'ai-content-automation': {
    title: '자동화 전후 제작 시간',
    caption: '동일 범위의 조사·카피·디자인·게시 작업 시간을 피드 단위로 기록해 비교했습니다.',
    metrics: [
      { value: '3시간→30분', label: '브랜드당 평균 제작 시간' },
      { value: '83%↓', label: '제작 시간 단축', countTo: 83, suffix: '%↓' },
      { value: '29개+', label: '자동 생성 피드', countTo: 29, suffix: '개+' },
    ],
    bars: [
      { label: '자동화 전', value: 100, display: '180분' },
      { label: '자동화 후', value: 17, display: '30분' },
    ],
  },
  salmidalla: {
    title: '판매 이후 다음 시즌으로 돌린 신호',
    caption: '판매 수량, 채널 성장, 오프라인 접점을 다음 시즌 상품 개선의 근거로 삼았습니다.',
    metrics: [
      { value: '140벌', label: '21SS 한정 수량 완판', countTo: 140, suffix: '벌' },
      { value: '464→863명', label: '인스타 팔로워' },
      { value: '3회', label: '팝업스토어 운영', countTo: 3, suffix: '회' },
    ],
    bars: [
      { label: '초기 팔로워', value: 54, display: '464명' },
      { label: '성장 후', value: 100, display: '863명' },
    ],
  },
  'areun-sai': {
    title: '콘텐츠 확장으로 만든 펀딩 결과',
    caption: '인터뷰 원천 콘텐츠를 도서·전시·굿즈 리워드로 묶어 후원 전환까지 연결했습니다.',
    metrics: [
      { value: '177%', label: '텀블벅 목표 대비 달성률', countTo: 177, suffix: '%' },
      { value: '36명', label: '후원자', countTo: 36, suffix: '명' },
      { value: '9명', label: '운영 팀', countTo: 9, suffix: '명' },
    ],
    bars: [
      { label: '펀딩 목표', value: 56, display: '100%' },
      { label: '최종 달성', value: 100, display: '177%' },
    ],
  },
};
const evidence = evidenceBySlug[project.slug];
---

<Layout
  title={`${project.name} — 서정일`}
  description={project.subtitle}
  ogUrl={pageOgUrl}
>
  <Nav />

  <main id="main-content" class="cs">

    <!-- Header -->
    <header class="cs-header">
      <div class="container">
        <a href={base} class="cs-back">← 모든 프로젝트</a>

        <div class="cs-meta">
          <span class="label label--accent">{project.category}</span>
          <span class="cs-dot">·</span>
          <span class="label">{project.period}</span>
        </div>

        <h1 class="cs-title">{project.title}</h1>
        <p class="cs-sub">{project.subtitle}</p>

        <div class="cs-tag-row">
          {project.tags.map(t => <span class="chip">{t}</span>)}
        </div>
        {project.links && project.links.length > 0 && (
          <div class="cs-link-row">
            {project.links.map(link => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="cs-link-cta">
                {link.label} ↗
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Highlight stat bar -->
    <div class="cs-stat-bar">
      <div class="container cs-stat-inner">
        <span class="cs-stat-num">{project.kpi ?? project.highlight}</span>
        <span class="cs-stat-label">{project.kpiLabel ?? '핵심 성과'}</span>
      </div>
    </div>

    <!-- TL;DR -->
    <div class="cs-tldr">
      <div class="container cs-tldr-inner">
        <div class="cs-tldr-item">
          <p class="label label--accent cs-tldr-label">문제</p>
          <p class="cs-tldr-text">{problemShort}</p>
        </div>
        <div class="cs-tldr-item">
          <p class="label label--accent cs-tldr-label">역할</p>
          <p class="cs-tldr-text">{project.content.contribution.role}</p>
        </div>
        <div class="cs-tldr-item">
          <p class="label label--accent cs-tldr-label">결과</p>
          <p class="cs-tldr-text">{project.content.results[0]?.desc}</p>
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="container cs-body">

      {evidence && (
        <section class="cs-sec cs-evidence" aria-labelledby="evidence-title">
          <div class="cs-evidence-card">
            <div class="cs-evidence-head">
              <h2 id="evidence-title" class="label label--accent cs-sec-label">Evidence</h2>
              <p class="cs-evidence-title">{evidence.title}</p>
              <p class="cs-evidence-caption">{evidence.caption}</p>
            </div>

            <div class="cs-evidence-metrics">
              {evidence.metrics.map((metric) => (
                <div class="cs-evidence-metric">
                  <span
                    class="cs-evidence-value"
                    data-count-to={metric.countTo}
                    data-count-prefix={metric.prefix}
                    data-count-suffix={metric.suffix}
                    data-count-precision={metric.precision}
                  >
                    {metric.value}
                  </span>
                  <span class="cs-evidence-label">{metric.label}</span>
                  {metric.note && <span class="cs-evidence-note">{metric.note}</span>}
                </div>
              ))}
            </div>

            {evidence.bars && (
              <div class="cs-meter-list" aria-label={`${evidence.title} 비교 막대`}>
                {evidence.bars.map((bar) => (
                  <div class="cs-meter-row">
                    <div class="cs-meter-meta">
                      <span class="cs-meter-label">{bar.label}</span>
                      <span class="cs-meter-display">{bar.display}</span>
                    </div>
                    <div class="cs-meter-track" aria-hidden="true">
                      <span
                        class="cs-meter-fill"
                        data-meter-bar
                        style={`--meter-width:${Math.min(Math.max(bar.value, 0), 100)}%`}
                      ></span>
                    </div>
                    {bar.note && <p class="cs-evidence-note">{bar.note}</p>}
                  </div>
                ))}
              </div>
            )}

            {evidence.stages && (
              <ol class="cs-stage-list" role="list" aria-label={`${evidence.title} 단계`}>
                {evidence.stages.map((stage, i) => (
                  <li class="cs-stage-item">
                    <span class="cs-stage-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="cs-stage-label">{stage}</span>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </section>
      )}

      {shots.length > 0 && (
        <section class="cs-sec cs-gallery-sec">
          <h2 class="label label--accent cs-sec-label">산출물</h2>
          <div class="cs-gallery-wrap at-start">
            <div class="cs-gallery" data-gallery>
              {shots.map((s, i) => (
                <figure class="cs-gallery-item">
                  <button
                    type="button"
                    class="cs-shot-inner"
                    data-shot
                    data-src={assetPath(s.src)}
                    data-caption={s.caption ?? ''}
                    data-url={s.url ?? ''}
                    aria-label={`${s.caption ?? '산출물'} 크게 보기`}
                  >
                    <img src={assetPath(s.src)} alt={s.caption ?? ''} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                    {s.caption && <div class="cs-shot-overlay"><span>{s.caption}</span></div>}
                  </button>
                </figure>
              ))}
            </div>
            <button type="button" class="cs-gallery-nav is-prev" data-dir="-1" aria-label="이전 산출물">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="cs-gallery-nav is-next" data-dir="1" aria-label="다음 산출물">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </section>
      )}

      <!-- 01 Results -->
      <section class="cs-sec">
        <h2 class="label label--accent cs-sec-label">01 · Results</h2>
        <div class="cs-results">
          {project.content.results.map(r => (
            <div class="cs-result">
              <p class="cs-result-label">{r.label}</p>
              <p class="cs-result-val">{r.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="line" />

      <!-- 02 Problem -->
      <section class="cs-sec">
        <h2 class="label label--accent cs-sec-label">02 · Problem</h2>
        <p class="cs-prose">{project.content.problem}</p>
      </section>

      <hr class="line" />

      <!-- 03 Approach -->
      <section class="cs-sec">
        <h2 class="label label--accent cs-sec-label">03 · Approach</h2>
        <ol class="cs-steps" role="list">
          {project.content.approach.map(a => (
            <li class="cs-step">
              <span class="cs-step-n">{a.num}</span>
              <div class="cs-step-body">
                <h3 class="cs-step-title">{a.step}</h3>
                <p class="cs-step-desc">{a.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      {project.content.flow && (
        <>
          <hr class="line" />
          <section class="cs-sec">
            <h2 class="label label--accent cs-sec-label">{project.content.flow.title}</h2>
            {project.content.flow.caption && (
              <p class="cs-flow-caption">{project.content.flow.caption}</p>
            )}
            <Flow flow={project.content.flow} />
          </section>
        </>
      )}

      {hasInsights ? (
        <>
          <hr class="line" />
          <section class="cs-sec">
            <h2 class="label label--accent cs-sec-label">04 · Key Insight</h2>
            <div class="cs-insights">
              {project.content.insights?.map(ins => (
                <div class="cs-insight">
                  <span class="cs-insight-num">{ins.num}</span>
                  <div class="cs-insight-body">
                    <h3 class="cs-insight-title">{ins.title}</h3>
                    <p class="cs-insight-desc">{ins.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </>
      ) : null}

      {project.content.architecture && (
        <>
          <hr class="line" />
          <section class="cs-sec">
            <h2 class="label label--accent cs-sec-label">{project.content.architecture.title}</h2>
            {project.content.architecture.caption && (
              <p class="cs-flow-caption">{project.content.architecture.caption}</p>
            )}
            <Architecture architecture={project.content.architecture} />
          </section>
        </>
      )}

      <hr class="line" />

      <!-- Contribution -->
      <section class="cs-sec">
        <h2 class="label label--accent cs-sec-label">05 · Contribution</h2>
        <dl class="cs-contrib">
          {[
            { k: 'Role',   v: project.content.contribution.role },
            { k: 'Scope',  v: project.content.contribution.scope },
            { k: 'Output', v: project.content.contribution.output },
          ].map(row => (
            <>
              <div class="cc-row">
                <dt class="cc-key">{row.k}</dt>
                <dd class="cc-val">{row.v}</dd>
              </div>
              <hr class="line" />
            </>
          ))}
        </dl>
      </section>

    </div>

    <!-- Next project -->
    <div class="cs-next">
      <div class="container">
        <p class="label" style="margin-bottom:0.875rem">다음 프로젝트</p>
        <a href={`${base}/projects/${next.slug}`} class="cs-next-link">
          <span class="cs-next-name">{next.name}</span>
          <span class="cs-next-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Lightbox -->
    <div class="cs-lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="산출물 크게 보기">
      <button type="button" class="cs-lightbox-close" data-lightbox-close aria-label="닫기">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <figure class="cs-lightbox-fig">
        <img data-lightbox-img alt="" />
        <figcaption class="cs-lightbox-cap">
          <span data-lightbox-cap></span>
          <a href="#" data-lightbox-link target="_blank" rel="noopener noreferrer" hidden>원본 보기 ↗</a>
        </figcaption>
      </figure>
    </div>

  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) gsap.registerPlugin(ScrollTrigger);

  const formatCount = (value, precision) => {
    return value.toLocaleString('ko-KR', {
      minimumFractionDigits: precision,
      maximumFractionDigits: precision,
    });
  };

  const renderCount = (el, value) => {
    const precision = Number.parseInt(el.dataset.countPrecision || '0', 10);
    const prefix = el.dataset.countPrefix || '';
    const suffix = el.dataset.countSuffix || '';
    el.textContent = `${prefix}${formatCount(value, precision)}${suffix}`;
  };

  document.querySelectorAll('[data-count-to]').forEach((el) => {
    if (!(el instanceof HTMLElement)) return;
    const target = Number.parseFloat(el.dataset.countTo || '');
    if (!Number.isFinite(target)) return;
    if (prefersReducedMotion) {
      renderCount(el, target);
      return;
    }

    const state = { value: 0 };
    gsap.to(state, {
      value: target,
      duration: 1.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      onUpdate: () => renderCount(el, state.value),
      onComplete: () => renderCount(el, target),
    });
  });

  if (!prefersReducedMotion) {
    const motionContext = gsap.context(() => {
      gsap.utils.toArray('.cs-sec').forEach((section) => {
        if (!(section instanceof HTMLElement)) return;
        gsap.from(section, {
          autoAlpha: 0,
          y: 18,
          duration: 0.55,
          ease: 'power3.out',
          scrollTrigger: { trigger: section, start: 'top 88%', once: true },
        });
      });

      gsap.utils.toArray('[data-meter-bar]').forEach((bar) => {
        if (!(bar instanceof HTMLElement)) return;
        gsap.fromTo(
          bar,
          { scaleX: 0 },
          {
            scaleX: 1,
            duration: 0.9,
            ease: 'power3.out',
            scrollTrigger: { trigger: bar, start: 'top 90%', once: true },
          },
        );
      });

      ScrollTrigger.refresh();
    });

    window.addEventListener('pagehide', () => motionContext.revert(), { once: true });
  }

  document.querySelectorAll('.cs-gallery-wrap').forEach((wrap) => {
    if (!(wrap instanceof HTMLElement)) return;
    const gallery = wrap.querySelector('[data-gallery]');
    if (!(gallery instanceof HTMLElement)) return;
    const update = () => {
      const max = gallery.scrollWidth - gallery.clientWidth - 1;
      wrap.classList.toggle('at-start', gallery.scrollLeft <= 0);
      wrap.classList.toggle('at-end', gallery.scrollLeft >= max);
    };
    wrap.querySelectorAll('.cs-gallery-nav').forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      btn.addEventListener('click', () => {
        const dir = btn.dataset.dir === '-1' ? -1 : 1;
        gallery.scrollBy({ left: dir * Math.min(gallery.clientWidth * 0.85, 420), behavior: prefersReducedMotion ? 'auto' : 'smooth' });
      });
    });
    gallery.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });

  // Lightbox — 산출물 이미지 크게 보기
  const lb = document.querySelector('[data-lightbox]');
  if (lb instanceof HTMLElement) {
    const lbImg = lb.querySelector('[data-lightbox-img]');
    const lbCap = lb.querySelector('[data-lightbox-cap]');
    const lbLink = lb.querySelector('[data-lightbox-link]');
    const closeBtn = lb.querySelector('[data-lightbox-close]');
    let lastFocused: Element | null = null;
    const focusableSelector = [
      'a[href]:not([hidden])',
      'button:not([disabled]):not([hidden])',
      'input:not([disabled]):not([hidden])',
      'select:not([disabled]):not([hidden])',
      'textarea:not([disabled]):not([hidden])',
      '[tabindex]:not([tabindex="-1"]):not([hidden])',
    ].join(',');
    const backgroundTargets = [
      document.querySelector('.skip-link'),
      document.querySelector('.nav'),
      ...document.querySelectorAll('.cs > :not(.cs-lightbox)'),
    ].filter((el): el is HTMLElement => el instanceof HTMLElement);
    const backgroundState = new Map<HTMLElement, { inert: boolean; ariaHidden: string | null }>();
    const getFocusable = () => {
      return [...lb.querySelectorAll(focusableSelector)].filter((el): el is HTMLElement => {
        if (!(el instanceof HTMLElement)) return false;
        if (el.closest('[hidden]')) return false;
        const rect = el.getBoundingClientRect();
        return rect.width > 0 && rect.height > 0;
      });
    };
    const setBackgroundDisabled = (disabled: boolean) => {
      backgroundTargets.forEach((el) => {
        if (disabled) {
          if (!backgroundState.has(el)) {
            backgroundState.set(el, {
              inert: el.inert,
              ariaHidden: el.getAttribute('aria-hidden'),
            });
          }
          el.inert = true;
          el.setAttribute('aria-hidden', 'true');
          return;
        }

        const previous = backgroundState.get(el);
        if (!previous) return;
        el.inert = previous.inert;
        if (previous.ariaHidden === null) {
          el.removeAttribute('aria-hidden');
        } else {
          el.setAttribute('aria-hidden', previous.ariaHidden);
        }
      });
      if (!disabled) backgroundState.clear();
    };
    const open = (src: string, caption: string, url: string, opener: HTMLElement | null = null) => {
      if (lbImg) { lbImg.setAttribute('src', src); lbImg.setAttribute('alt', caption || ''); }
      if (lbCap) lbCap.textContent = caption || '';
      if (lbLink instanceof HTMLAnchorElement) {
        if (url) { lbLink.href = url; lbLink.hidden = false; } else { lbLink.hidden = true; }
      }
      lastFocused = opener ?? document.activeElement;
      lb.hidden = false;
      setBackgroundDisabled(true);
      document.body.style.overflow = 'hidden';
      if (closeBtn instanceof HTMLElement) closeBtn.focus();
    };
    const close = () => {
      const restoreFocus = lastFocused instanceof HTMLElement ? lastFocused : null;
      lb.hidden = true;
      setBackgroundDisabled(false);
      document.body.style.overflow = '';
      if (restoreFocus) {
        restoreFocus.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        restoreFocus.focus();
        window.setTimeout(() => {
          restoreFocus.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          restoreFocus.focus();
        }, 80);
      }
    };
    document.querySelectorAll('[data-shot]').forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      btn.addEventListener('click', () => {
        open(btn.dataset.src || '', btn.dataset.caption || '', btn.dataset.url || '', btn);
      });
    });
    if (closeBtn) closeBtn.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;

      const focusable = getFocusable();
      if (focusable.length === 0) {
        e.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>

